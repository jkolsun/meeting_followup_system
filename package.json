{
  "name": "meeting-followup-system",
  "version": "1.0.0",
  "description": "Automated meeting follow-up and reminder system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/public dist/",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "setup-gmail": "tsx src/scripts/setup-gmail.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.3.0",
    "@supabase/supabase-js": "^2.91.1",
    "bullmq": "^5.1.0",
    "date-fns": "^3.2.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^131.0.0",
    "ioredis": "^5.3.2",
    "nodemailer": "^6.9.8",
    "pg": "^8.17.2",
    "sql.js": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.11.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
